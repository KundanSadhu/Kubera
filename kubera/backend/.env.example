# Local dev defaults (docker-compose). On Render, set via Dashboard → Advanced → Env Vars.
# DATABASE_URL: paste Render Internal Database URL. App auto-converts
# postgresql:// → postgresql+asyncpg:// so paste as-is.
DATABASE_URL=postgresql+asyncpg://kubera:kubera@postgres:5432/kubera
CHROMA_HOST=chroma
CHROMA_PORT=8000
# JWT_SECRET: min 32 chars. Render: generate random value.
JWT_SECRET=change-me-32chars-minimum-for-jwt-production
ADMIN_EMAIL=admin@kubera.local
ADMIN_PASSWORD=kubera123
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OPENAI_API_KEY=
LITELLM_MODEL=openai/gpt-4o-mini
WHATSAPP_MODE=mock
# Local: http://localhost:5173 | Render testing: * | Prod: https://your-frontend.vercel.app
CORS_ORIGINS=*
